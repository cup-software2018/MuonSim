# Build and install trees
#
# Both live inside the source tree here, and both are reproducible from CMake.
build/
install/
# An in-source configure, should anyone ever do one by accident.
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile
compile_commands.json
setup_muonsim.sh

# Simulation output
#
# run/output holds the job files -- 1.8 GB for seven runs at the time of writing,
# and a production array puts hundreds there. Never commit these; they are
# reproducible from the macro, the seed and the installed binary, all of which the
# job log records.
run/output/
run/*.C
run/*.png
test

# Output that lands in whatever directory a run or a macro was started from.
/*.root
/*.png
*.log

# ROOT
#
# ACLiC leaves these beside any macro it compiles, and the dictionary files are
# generated by ROOT_GENERATE_DICTIONARY.
*_C.so
*_C.d
*_C_ACLiC_dict_rdict.pcm
*_rdict.pcm
*.rootmap
AutoDict_*

# But data/ is INPUT, not output: the flux histogram and the YAML tables ship
# with the project and ResolveDataFile expects to find them. The /*.root rule
# above is anchored to the top level so it does not reach them, and this makes
# that explicit in case the rule is ever loosened.
data/muon_flux.root

# Crash debris. Geant4 aborts with a core dump on a FatalException, so these
# appear during ordinary development.
core
core.[0-9]*
vgcore.*

# Editors and tools
# .lh/ is VS Code Local History. Inline comments are NOT a thing in .gitignore --
# a '#' only starts a comment at the start of a line -- so they go above.
.lh/
.vscode/
.idea/
*.swp
*~
.DS_Store
__pycache__/
*.pyc

.agents
.claude
