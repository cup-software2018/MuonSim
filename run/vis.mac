# Visualization settings for interactive mode

/run/initialize

/vis/open OGL 600x600-0+0

/vis/viewer/set/autoRefresh false
/vis/verbose errors

/vis/drawVolume

/vis/viewer/set/upVector 0 0 1
/vis/viewer/set/viewpointThetaPhi 90 0
/vis/viewer/set/lightsVector 0 0 -1
/vis/viewer/set/style surface
/vis/viewer/set/hiddenMarker true
/vis/viewer/set/lineSegmentsPerCircle 100

/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByCharge
/vis/modeling/trajectories/drawByCharge-0/default/setDrawStepPts true
/vis/modeling/trajectories/drawByCharge-0/default/setStepPtsSize 2

/vis/scene/endOfEventAction accumulate

/vis/geometry/set/visibility World 0 false

# The bulk rock is a 16 m sphere and hides everything inside it, so it is off and
# RockSurfaceLayer -- the 1 m of rock U/Th/K decays are sampled in -- is drawn as an
# outline instead. That puts the cavern boundary on screen without covering the
# detectors. Set Rock back to true to see the rock itself.
/vis/geometry/set/visibility Rock 0 false
/vis/geometry/set/forceWireframe RockSurfaceLayer 0 true

# For a cut through the layer instead of an outline, showing the 1 m over the dome
# and the slab under the floor in section:
#/vis/geometry/set/forceWireframe RockSurfaceLayer 0 false
#/vis/geometry/set/forceSolid RockSurfaceLayer 0 true
#/vis/viewer/set/sectionPlane on 0 0 0 m 0 1 0

/vis/scene/add/axes 0 0 0 1 m

/vis/viewer/set/autoRefresh true
/vis/verbose warnings
