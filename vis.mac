# Visualization settings for interactive mode

/run/initialize

/vis/open OGL 600x600-0+0

/vis/viewer/set/autoRefresh false
/vis/verbose errors

/vis/drawVolume

/vis/viewer/set/upVector 0 0 1
/vis/viewer/set/viewpointThetaPhi 90 0
/vis/viewer/set/lightsVector 0 0 -1
/vis/viewer/set/style surface
/vis/viewer/set/hiddenMarker true
/vis/viewer/set/lineSegmentsPerCircle 100

/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByCharge
/vis/modeling/trajectories/drawByCharge-0/default/setDrawStepPts true
/vis/modeling/trajectories/drawByCharge-0/default/setStepPtsSize 2

/vis/scene/endOfEventAction accumulate

/vis/geometry/set/visibility World 0 false

# The rock shell wraps the hall and would hide everything inside it, so it is drawn
# as an outline. That puts the hall boundary on screen without covering the
# detectors.
/vis/geometry/set/forceWireframe Rock 0 true

# For a cut through it instead, showing the shell's thickness over the dome, under
# the floor and around the pit walls:
#/vis/geometry/set/forceWireframe Rock 0 false
#/vis/geometry/set/forceSolid Rock 0 true
#/vis/viewer/set/sectionPlane on 0 0 0 m 0 1 0

/vis/scene/add/axes 0 0 0 1 m

/vis/viewer/set/autoRefresh true
/vis/verbose warnings
